{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "covers"],
  "properties": {
    "date": { "$ref": "defs.schema.json#/$defs/isoDate" },
    "covers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/isoDate" }
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "defs.schema.json#/$defs/nonEmptyString" }
    }
  }
}

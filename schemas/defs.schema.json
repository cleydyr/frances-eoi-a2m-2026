{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frances-eoi.local/schemas/defs.schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "isoDate": {
      "type": "string",
      "format": "date"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
